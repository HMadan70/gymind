POSTGRES_USER=gymind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gymind
# A second database, "gymind_test", is created alongside POSTGRES_DB by
# db-init/001-create-test-db.sh (same user/password, same instance) for the
# backend test suite. It is not configured here because nothing in this
# file names it directly - it's a fixed name the test suite's own DB-URL
# swap assumes (see backend/conftest.py and backend/.env.example).

JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://app.example.com

OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
