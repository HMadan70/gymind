# The test suite (backend/conftest.py) never uses this database directly -
# it swaps the database name to "gymind_test" on the same host/credentials
# before running. That sibling database must already exist (docker-compose's
# db-init/001-create-test-db.sh creates it alongside this one on a fresh
# volume); it is never migrated or copied from this one.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/gymind
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Where uploaded meal/progress photos are stored on local disk. Optional -
# defaults to backend/uploads/ (gitignored) when unset; docker-compose.yml
# sets this to /app/uploads and mounts a named volume there.
UPLOAD_DIR=./uploads

# Per-authenticated-user rate limit on POST /coach (in-memory, single
# process - see app/coach_rate_limit.py for why and its limitations).
# Both optional; these are the defaults.
COACH_RATE_LIMIT_REQUESTS=10
COACH_RATE_LIMIT_WINDOW_SECONDS=60
